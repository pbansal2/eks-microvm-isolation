# Terraform state holds the cluster CA bundle, OIDC metadata and KMS key ids.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# Plan files are readable archives of the whole configuration plus state.
tfplan
*.tfplan

# Operator-specific values, including API endpoint allow-lists.
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# Local kubeconfigs
kubeconfig
kubeconfig_*

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code per-user settings (project-level .claude/settings.json is fine to share)
.claude/settings.local.json

# Script and tunnel logs
*.log

# Generated by `scripts/install-kata.sh --render`; regenerate, don't commit.
k8s/kata/rendered/

# Local working files, not part of the published project.
CLAUDE.md
Prompts.md

# Internal design notes, kept locally only.
docs/
